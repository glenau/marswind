{
  "name": "marswind",
  "version": "0.1.0",
  "description": "Live subtitles and translation for your computer's audio, running entirely offline",
  "type": "module",
  "keywords": [
    "subtitles",
    "captions",
    "translation",
    "speech-recognition",
    "whisper",
    "offline",
    "tauri",
    "macos"
  ],
  "homepage": "https://github.com/glenau/marswind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glenau/marswind.git"
  },
  "bugs": {
    "url": "https://github.com/glenau/marswind/issues"
  },
  "author": "Gleb Naumov",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "dev:macos": "bash scripts/dev-macos.sh",
    "install:macos": "bash scripts/install-macos.sh",
    "build:sidecar": "bash scripts/build-sidecar.sh",
    "build:dmg": "bash scripts/build-dmg.sh",
    "build:icons": "bash scripts/build-icons.sh",
    "build:social": "python3 scripts/make-social-preview.py",
    "licenses": "python3 scripts/collect-licenses.py"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "@tauri-apps/cli": "^2"
  }
}
