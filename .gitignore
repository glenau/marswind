.DS_Store
node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# models and test artifacts
/models/
/testdata/

# sidecar binaries, produced by scripts/build-sidecar.sh
/src-tauri/binaries/
/translator/target/

# the rasterized icon, produced by scripts/build-icons.sh from assets/icon.svg.
# The icon set it feeds - src-tauri/icons/ - is committed; this step is not.
/assets/icon.png

# the social preview's intermediate, produced by scripts/make-social-preview.py.
# The other way round from the icon above: here the SVG is the throwaway - most
# of its 135 KB is the app icon inlined as base64, which is nothing anyone can
# read or argue with - and the PNG is the artifact, because uploading it is a
# manual step GitHub has no API for.
/assets/social-preview.svg

# editor and assistant scratch. .vscode/ is committed because it is two files
# that point at the right extensions; everything below is one person's setup.
/.claude/
/.idea/
/.zed/
*.code-workspace
