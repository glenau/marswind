root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# rustfmt's own defaults, so an editor does not fight `cargo fmt`.
[*.rs]
indent_size = 4
max_line_length = 100

[*.{sh,bash}]
indent_style = tab

[*.py]
indent_size = 4

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false
